# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# The Gmail address that SENDS the contact form emails (must have an App Password, see below).
EMAIL_HOST_USER=your.email@gmail.com

# A Gmail App Password (NOT your regular Gmail password).
# Generate one at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the Google account first.
EMAIL_HOST_PASSWORD=your16digitapppassword

# The inbox that contact form submissions get forwarded to.
CONTACT_RECIPIENT_EMAIL=igifarudavid@gmail.com

# --- Production-only settings (leave unset for local dev; required on PythonAnywhere) ---

# A long random string, different from the one committed in settings.py.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Must be the literal string False in production. Leave unset locally (defaults to True).
DEBUG=

# Comma-separated, no spaces. e.g. yourusername.pythonanywhere.com
ALLOWED_HOSTS=
